example (x : ℝ) : |x + 3| < 5 → -8 < x ∧ x < 2 := by
  rw [abs_lt]
  intro h
  constructor <;> linarith

example : 3 ∣ Nat.gcd 6 15 := by
  rw [Nat.dvd_gcd_iff]
  constructor <;> norm_num

end

theorem not_monotone_iff {f : ℝ → ℝ} : ¬Monotone f ↔ ∃ x y, x ≤ y ∧ f x > f y := by
  rw [Monotone]
  push_neg
  rfl

example : ¬Monotone fun x : ℝ ↦ -x := by
  unfold Monotone
  intro h
  have g' : (0 : ℝ)  <= (1 : ℝ)  := by linarith
  have g : (fun x : ℝ ↦ -x) 0 <= (fun x : ℝ ↦ -x) 1 := by
    apply h
    linarith
  simp at g
  linarith

section
variable {α : Type*} [PartialOrder α]
variable (a b : α)

example : a < b ↔ a ≤ b ∧ a ≠ b := by
  rw [lt_iff_le_not_ge]
  constructor
  intro h
  constructor
  exact h.1
  intro h'
  have h'' : b <= a := by
    exact Std.le_of_eq (id (Eq.symm h'))
  exact h.2 h''
  intro h
  constructor
  exact h.1
  intro g
  have g' : a = b := by
    apply le_antisymm
    exact h.1
    trivial
  exact h.2 g'

end

section
variable {α : Type*} [Preorder α]
variable (a b c : α)

example : ¬a < a := by
  rw [lt_iff_le_not_ge]
  intro h
  exact h.2 h.1

example : a < b → b < c → a < c := by
  intro h g
  calc
    a < b := h
    _ < c := g



end
